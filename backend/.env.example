# 서버 환경변수 이름 목록 (.env 는 gitignore 됨). 이름만 적고 값은 비운다.
# 서버는 .env 파일을 스스로 읽지 않고 os.environ 만 읽는다. 켜기 전에 셸에서 불러온다 (backend/ 에서):
#   set -a; source <(grep -vE '^[[:space:]]*(#|$)|=[[:space:]]*$' .env); set +a
#   uvicorn app.main:app --reload --port 8080
# 위 grep 이 값을 비워 둔 줄(KEY=)을 건너뛰어서, 비운 항목은 기본값을 쓴다.
# (uvicorn --env-file .env 는 쓰지 않는다: python-dotenv 가 필요하고, 빈 값을 빈 문자열로 넘겨 기본값을 막는다) 변수 이름은 [제안]. 팀이 확정하면 CLAUDE.md 에도 옮긴다.

# SQLite 파일 경로 (기본: backend/didimdol.db)
DATABASE_PATH=
# 올린 원본 파일을 저장할 폴더 (기본: backend/uploads)
UPLOAD_DIR=

# Gemini API 키 (서버에서만 사용, 프론트에 두지 않음). 이름만 예약, 이번에는 쓰지 않음
GEMINI_API_KEY=
# Gemini 모델명 (코드에 적지 않고 여기서 바꾼다). 이름만 예약, 이번에는 쓰지 않음
GEMINI_MODEL=

# Google 로그인 (LOGIN-API.md). 값은 테크 리드에게 개인 메시지로 받는다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# http://localhost:5173/api/auth/google/callback (Google 콘솔에 등록한 값과 같게)
GOOGLE_REDIRECT_URI=
# 세션 쿠키 서명 키. 비워 두면 서버를 켤 때마다 새 키를 만들어 다시 로그인해야 한다
SESSION_SECRET_KEY=

# 사전 정보(이름·생년월일·연락처·주소) 암호화 키. Fernet.generate_key()로 만든다.
# 비워 두면 사전 정보 조회·저장 API가 500으로 실패한다 (평문 저장을 막기 위해 기본값을 두지 않음)
PRIOR_INFO_ENCRYPTION_KEY=
