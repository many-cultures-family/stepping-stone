# 복사해서 .env.local 로 사용 (.env.local 은 gitignore 됨)
# 주의: VITE_ 로 시작하는 값은 브라우저에 그대로 노출된다.
#       Gemini 등 LLM API 키는 절대 여기 넣지 않는다. 키는 backend/.env 에만 둔다.

# true 면 작성 목록·업로드·입력 항목·사전 정보·답변 검토를 src/mocks 목데이터로 처리한다.
# 로그인(Google)은 기본으로 항상 백엔드를 쓴다.
VITE_USE_MOCK=true

# true 면 로그인도 가짜 세션(시드 사용자 tester@example.com, 언어 vi)을 쓴다. VITE_USE_MOCK=true 일 때만 켜진다.
# Google 설정이나 백엔드 없이 로그인이 필요한 화면을 볼 때 켠다. 실제 로그인을 확인할 때는 끈다.
VITE_MOCK_LOGIN=false

# 개발 서버가 /api 요청을 넘길 FastAPI 주소
VITE_API_PROXY_TARGET=http://localhost:8080
